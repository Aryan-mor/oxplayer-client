# OXPlayer environment — copy this file to default.env and fill in your values.
# default.env is git-ignored; never commit it.

OXPLAYER=true

# Telegram app credentials (https://my.telegram.org)
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash

# Telegram bot & Mini App
BOT_USERNAME=@YourBotUsername
PROVIDER_BOT_USERNAME=@YourProviderBotUsername
OXPLAYER_TELEGRAM_WEBAPP_SHORT_NAME=YourMiniAppShortName
OXPLAYER_TELEGRAM_WEBAPP_URL=https://t.me/YourBotUsername/YourMiniAppShortName

# OXPlayer API base URL (local, ngrok, or production)
OXPLAYER_API_BASE_URL=https://your-api-url.example.com

# Subdl subtitle API key (https://subdl.com)
SUBDL_API_KEY=your_subdl_api_key
