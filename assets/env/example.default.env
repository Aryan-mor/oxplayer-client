# Copy to default.env — v2: claim-code login only (no TDLib, no ngrok).
# API target: oxplayer-be apps/api (default port 3004). From oxplayer-be: pnpm dev or pnpm dev:android

OXPLAYER=true
OXPLAYER_API_BASE_URL=http://192.168.1.10:3004

# Main bot for /login + dashboard help (synced by oxplayer-be pnpm client:sync or oxplayer pnpm dev:server)
OXPLAYER_BOT_USERNAME=YourMainBot

PROVIDER_BOT_USERNAME=@YourProviderBot

# Optional — public channel for downtime / release news (shown when API is unreachable)
# OXPLAYER_TELEGRAM_NEWS_CHANNEL=@YourOxplayerNews

# Optional
SUBDL_API_KEY=
